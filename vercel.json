{
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "my-portfolio-harshith.vercel.app"
        }
      ],
      "destination": "https://harshith-nayaka-l-portfolio.vercel.app/",
      "permanent": true
    },
