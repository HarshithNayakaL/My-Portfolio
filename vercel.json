      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "my-portfolio-harshith.vercel.app"
        }
      ],
      "destination": "https://harshith-nayaka-l-portfolio.vercel.app/:path*",
      "permanent": true
